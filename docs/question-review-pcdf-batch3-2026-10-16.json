  "items": [
    {
      "id": "26176d85-3fb2-414a-9419-ff3e7cd6a079",
      "item_number": 14,
      "previous_row_sha256": "396129079b44c4ab395dd4e997dc045022174a0c109a8f1b433b6935f30a9b45",
      "published_row_sha256": "fb2e8cc6b4d511cf45b637d7f3b632e38b7dfa45613436e6f5f29042a4f643ec",
      "patch": {
        "review_note": "Gabarito definitivo: Certo (C). Conferência individual em 16/10/2026.\nCada Poder exerce controle interno sobre seus próprios atos e agentes, além das formas de controle externo previstas na Constituição. O art. 74 prevê sistema de controle interno mantido de forma integrada pelos Poderes. Não se confunde controle interno com a fiscalização externa exercida com auxílio do tribunal de contas.\nExemplo: O Judiciário pode controlar administrativamente seus próprios serviços e despesas, sem que isso seja exercício de jurisdição sobre outro Poder.\nTeste rápido — Só o Executivo tem controle administrativo interno? Não.",
        "legal_basis": [
          {
            "url": "https://www.planalto.gov.br/ccivil_03/constituicao/constituicao.htm",
            "artigo": "70",
            "title": "Constituição da República Federativa do Brasil de 1988"
          },
          {
            "url": "https://www.planalto.gov.br/ccivil_03/constituicao/constituicao.htm",
            "artigo": "74",
            "title": "Constituição da República Federativa do Brasil de 1988"
          }
        ],
        "law_version_checked_at": "2026-10-16T16:13:27.780884+00:00",
        "current_syllabus_topic_id": "885aaa49-cb28-4700-ba93-e6f20d521bc8"
      },
      "evidence": {
        "legal": true,
        "reason": "Conferência individual da letra definitiva, dispositivo oficial e, quando aplicável, precedente do tribunal; recorte e exceções indicados no comentário, sem certificação de toda a disciplina.",
