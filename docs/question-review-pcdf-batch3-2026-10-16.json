    {
      "id": "5109e4aa-ab46-4892-896b-2402d2177054",
      "item_number": 71,
      "previous_row_sha256": "5d981852c09e7e824864ba3973d287ef579f3f79c2eeb614267f7a2e5065a9d8",
      "published_row_sha256": "6dced5fcf373307095a7d366f2cef3b1b2d9aa1d5b6006b5a83c1eb345bce5b4",
      "patch": {
        "review_note": "Gabarito definitivo: Certo (C). Conferência individual em 16/10/2026.\nO art. 156-A, § 1º, XI, exclui do IBS as prestações de comunicação nas modalidades de radiodifusão sonora e de sons e imagens de recepção livre e gratuita. É regra específica, que não se estende automaticamente a serviços pagos ou plataformas digitais. A inclusão constitucional pela EC 132/2023 não se confunde com o calendário de implementação e produção de efeitos do novo sistema tributário.\nExemplo: Recepção livre e gratuita de TV aberta enquadra-se na hipótese descrita. TV por assinatura não se torna automaticamente abrangida pela mesma previsão.\nTeste rápido — A não incidência abrange indistintamente toda comunicação paga ou gratuita? Não.",
        "legal_basis": [
          {
            "url": "https://www.planalto.gov.br/ccivil_03/constituicao/constituicao.htm",
            "artigo": "156-A",
            "title": "Constituição da República Federativa do Brasil de 1988"
          }
        ],
        "law_version_checked_at": "2026-10-16T16:13:27.780884+00:00",
        "current_syllabus_topic_id": "b587cbe4-c0e6-4c91-8383-fe3774afde4b"
      },
      "evidence": {
        "legal": true,
        "reason": "Conferência individual da letra definitiva, dispositivo oficial e, quando aplicável, precedente do tribunal; recorte e exceções indicados no comentário, sem certificação de toda a disciplina.",
        "sources": [
