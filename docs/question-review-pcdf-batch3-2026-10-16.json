    {
      "id": "511a541b-413d-4f1f-b885-a1084fd515d5",
      "item_number": 9,
      "previous_row_sha256": "f119e008247b63f1a3d2e9573765002ed658e6a1a86c9da4bf5fdc1dc0b8fab5",
      "published_row_sha256": "3fbdf3f2bbb9b420b2a25cb2f961cb1f3bd421818bdd53fb016592ceb11d5a34",
      "patch": {
        "review_note": "Gabarito definitivo: Errado (E). Conferência individual em 16/10/2026.\nA finalidade não é o único elemento que distingue decreto e resolução. Competência, autoridade emitente, forma e regime jurídico também importam, conforme a espécie do ato. A Constituição prevê, por exemplo, decretos do Executivo e competências do Senado exercidas por resolução, com funções distintas.\nExemplo: Decreto de execução de lei e resolução do Senado não se tornam o mesmo ato por ambos produzirem efeitos normativos.\nTeste rápido — A diferença decorre exclusivamente da finalidade? Não.",
        "legal_basis": [
          {
            "url": "https://www.planalto.gov.br/ccivil_03/constituicao/constituicao.htm",
            "artigo": "52",
            "title": "Constituição da República Federativa do Brasil de 1988"
          },
          {
            "url": "https://www.planalto.gov.br/ccivil_03/constituicao/constituicao.htm",
            "artigo": "84",
            "title": "Constituição da República Federativa do Brasil de 1988"
          }
        ],
        "law_version_checked_at": "2026-10-16T16:13:27.780884+00:00",
        "current_syllabus_topic_id": "885aaa49-cb28-4700-ba93-e6f20d521bc8"
